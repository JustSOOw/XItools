### 
# 本地环境配置示例文件
# 复制此文件为 .env.local 用于本地开发的个人配置
# .env.local 文件会被 git 忽略，不会提交到版本控制

# 应用基本信息
VITE_APP_NAME=XItools
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=local

# 后端服务配置
# 本地开发时可以选择连接本地服务或远程服务
VITE_BACKEND_URL=http://localhost:3000

# 如果需要连接远程服务进行测试，取消下面的注释
# VITE_BACKEND_URL=http://xitools.furdow.com

# API配置
VITE_API_TIMEOUT=10000

# 开发模式配置
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# 可选：自定义端口（如果默认端口被占用）
# VITE_DEV_PORT=5174
