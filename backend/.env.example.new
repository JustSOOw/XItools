# XItools 后端环境变量配置
# 复制此文件为 .env 并根据需要修改配置

# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 数据库配置
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xitools"

# CORS配置 - 允许的请求来源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# 日志配置
LOG_LEVEL=info

# 调试模式配置
DEBUG_MODE=false

# 代理信任配置（生产环境中启用）
# TRUST_PROXY=true

# JWT配置（生产环境中必须修改）
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d
