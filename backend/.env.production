# 生产环境配置
# 用于服务器部署

# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 数据库配置 - 生产环境使用Docker内部网络
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD:-postgres}@postgres:5432/xitools"

# CORS配置 - 生产环境允许域名访问
CORS_ORIGINS=http://xitools.furdow.com,https://xitools.furdow.com,http://localhost:3000

# 日志配置
LOG_LEVEL=info

# 生产模式配置
DEBUG_MODE=false

# 安全配置
TRUST_PROXY=true
