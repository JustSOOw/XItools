# 开发环境配置
# 用于本地开发

# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 数据库配置
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xitools"

# CORS配置 - 开发环境允许本地前端访问
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 日志配置
LOG_LEVEL=debug

# 开发模式配置
DEBUG_MODE=true
