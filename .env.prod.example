# 生产环境配置文件示例
# 复制此文件为 .env.prod 并修改相应的值

# 数据库密码
POSTGRES_PASSWORD=your_secure_password_here

# CORS配置 - 添加你的域名
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://xitools.furdow.com,https://xitools.furdow.com

# 可选：如果需要自定义数据库连接
# DATABASE_URL=postgresql://postgres:your_password@postgres:5432/xitools
